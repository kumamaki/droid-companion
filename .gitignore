# Dependencies / build
node_modules/
dist/
*.exe
# local compile artifacts
/droid-companion
/droid-companion-*
/tmp/

# Local runtime state (never commit)
.sessions.json
.jobs/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Env / secrets
.env
.env.*
!.env.example

# Coverage / caches
.coverage/
.cache/

# Beads / Dolt — local machine wiring only, never committed.
# bd init copies global core.hooksPath hooks (which hardcode identity emails)
# into .beads/hooks/; committing .beads/ would leak them. Dolt-native beads
# syncs via `bd dolt push`/`pull`, not git.
.beads/
.dolt/
*.db
.beads-credential-key
