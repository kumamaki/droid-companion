{
  "name": "droid-companion",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "Named multi-turn companion sessions for Factory Droid (CLI)",
  "author": "kumamaki <kumamaki@proton.me>",
  "license": "MIT",
  "bin": {
    "droid-companion": "./src/companion.ts",
    "droid-companion-dev": "./src/companion-dev.ts"
  },
  "scripts": {
    "droid-companion": "bun src/companion.ts",
    "droid-companion-dev": "bun src/companion-dev.ts",
    "doctor": "bun src/companion.ts doctor",
    "setup": "bun src/companion.ts setup",
    "build": "bash scripts/build-binary.sh",
    "build:multi": "bash scripts/build-binary.sh --multi",
    "clean": "bash scripts/clean.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "test": "bun test tests",
    "test:unit": "bun test tests",
    "test:cli": "bun scripts/smoke-cli.ts",
    "test:all": "bun run typecheck && bun run lint && bun run test && bun run test:cli",
    "release": "bash scripts/release.sh",
    "ship": "bash scripts/ship.sh",
    "smoke:classify": "bun scripts/smoke-classify.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumamaki/droid-companion.git"
  },
  "keywords": [
    "droid",
    "factory",
    "cli",
    "agents",
    "companion"
  ],
  "devDependencies": {
    "bun-types": "^1.3.14",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  }
}
